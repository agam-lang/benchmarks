{
  "targets": {
    "agam_llvm_o3_call_cache_off": {
      "name": "Agam LLVM O3",
      "language": "agam",
      "backend": "llvm",
      "optimization_level": 3,
      "build_then_run": true,
      "call_cache": false,
      "compiler": "agamc"
    },
    "agam_llvm_o3_call_cache_on": {
      "name": "Agam LLVM O3 + Call Cache",
      "language": "agam",
      "backend": "llvm",
      "optimization_level": 3,
      "build_then_run": true,
      "call_cache": true,
      "compiler": "agamc"
    },
    "agam_c_o3_call_cache_off": {
      "name": "Agam C O3",
      "language": "agam",
      "backend": "c",
      "optimization_level": 3,
      "build_then_run": true,
      "call_cache": false,
      "compiler": "agamc"
    },
    "agam_c_o3_call_cache_on": {
      "name": "Agam C O3 + Call Cache",
      "language": "agam",
      "backend": "c",
      "optimization_level": 3,
      "build_then_run": true,
      "call_cache": true,
      "compiler": "agamc"
    },
    "agam_jit_o2_call_cache_off": {
      "name": "Agam JIT O2",
      "language": "agam",
      "backend": "jit",
      "optimization_level": 2,
      "build_then_run": false,
      "call_cache": false,
      "compiler": "agamc"
    },
    "agam_jit_o2_call_cache_on": {
      "name": "Agam JIT O2 + Call Cache",
      "language": "agam",
      "backend": "jit",
      "optimization_level": 2,
      "build_then_run": false,
      "call_cache": true,
      "compiler": "agamc"
    },
    "rust_release": {
      "name": "Rust release",
      "language": "rust",
      "compiler": "rustc",
      "optimization_level": 3,
      "rust_flags": ["-C", "opt-level=3"]
    },
    "python_cpython": {
      "name": "CPython",
      "language": "python",
      "compiler": "cpython",
      "interpreter_key": "cpython"
    },
    "c_clang_o3": {
      "name": "Clang C O3",
      "language": "c",
      "compiler": "clang",
      "compiler_key": "clang_c_compiler",
      "compile_args": ["-O3"]
    },
    "cpp_clangxx_o3": {
      "name": "Clang++ O3",
      "language": "cpp",
      "compiler": "clang++",
      "compiler_key": "clang_cpp_compiler",
      "compile_args": ["-O3", "-std=c++20"]
    },
    "c_gcc_16_o3": {
      "name": "GCC 16 C O3",
      "language": "c",
      "compiler": "gcc",
      "compiler_key": "gcc_c_compiler",
      "compile_args": ["-O3", "-march=native", "-fno-math-errno", "-fno-trapping-math"]
    },
    "cpp_gcc_16_o3": {
      "name": "GCC 16 C++ O3",
      "language": "cpp",
      "compiler": "g++",
      "compiler_key": "gcc_cpp_compiler",
      "compile_args": ["-O3", "-march=native", "-std=c++20", "-fno-math-errno", "-fno-trapping-math"]
    },
    "c_clang_22_o3": {
      "name": "Clang 22 C O3",
      "language": "c",
      "compiler": "clang",
      "compiler_key": "clang22_c_compiler",
      "compile_args": ["-O3", "-march=native", "-ffast-math"]
    },
    "cpp_clang_22_o3": {
      "name": "Clang 22 C++ O3",
      "language": "cpp",
      "compiler": "clang++",
      "compiler_key": "clang22_cpp_compiler",
      "compile_args": ["-O3", "-march=native", "-std=c++20", "-ffast-math"]
    },
    "go_release": {
      "name": "Go release",
      "language": "go",
      "compiler": "go"
    }
  }
}
