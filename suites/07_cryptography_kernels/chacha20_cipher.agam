@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn chacha_quarter(a: i64, b: i64, c: i64, d: i64) -> i64 {
    let mask: i64 = i64_const(4294967295);
    let av: i64 = (a + b) & mask;
    let dv: i64 = ((d ^ av) << i64_const(16) | ((d ^ av) & mask) >> i64_const(16)) & mask;
    let cv: i64 = (c + dv) & mask;
    let bv: i64 = ((b ^ cv) << i64_const(12) | ((b ^ cv) & mask) >> i64_const(20)) & mask;
    let av2: i64 = (av + bv) & mask;
    let dv2: i64 = ((dv ^ av2) << i64_const(8) | ((dv ^ av2) & mask) >> i64_const(24)) & mask;
    let cv2: i64 = (cv + dv2) & mask;
    let bv2: i64 = ((bv ^ cv2) << i64_const(7) | ((bv ^ cv2) & mask) >> i64_const(25)) & mask;
    return (av2 + bv2 + cv2 + dv2) & mask;
}

fn chacha20_checksum(rounds: i64) -> i64 {
    let checksum: i64 = i64_const(0);
    let i: i64 = i64_const(0);
    while i < rounds {
        let s0: i64 = i64_const(1634760805);
        let s1: i64 = i64_const(857760878);
        let s2: i64 = i64_const(2036477234);
        let s3: i64 = i64_const(1797285236);
        let r: i64 = i64_const(0);
        while r < i64_const(10) {
            let q1: i64 = chacha_quarter(s0, s1, s2, s3);
            let q2: i64 = chacha_quarter(s1 + i, s2 + r, s3, s0);
            let q3: i64 = chacha_quarter(s2, s3 + i, s0 + r, s1);
            let q4: i64 = chacha_quarter(s3, s0, s1 + i, s2 + r);
            s0 = q1;
            s1 = q2;
            s2 = q3;
            s3 = q4;
            r = r + i64_const(1);
        }
        checksum = (checksum * i64_const(37) + s0 + s1 + s2 + s3) % i64_const(1000000007);
        i = i + i64_const(1);
    }
    return checksum;
}

fn main() -> i32 {
    print_int(chacha20_checksum(i64_const(1024)));
    return 0;
}
