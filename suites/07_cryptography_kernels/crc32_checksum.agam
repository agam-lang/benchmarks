@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn crc32_checksum(data_size: i64) -> i64 {
    let crc: i64 = i64_const(4294967295);
    let mask: i64 = i64_const(4294967295);
    let poly: i64 = i64_const(3988292384);
    let i: i64 = i64_const(0);
    while i < data_size {
        let byte_val: i64 = (i * i64_const(1103515245) + i64_const(12345)) & i64_const(255);
        crc = crc ^ byte_val;
        let bit: i64 = i64_const(0);
        while bit < i64_const(8) {
            if (crc & i64_const(1)) != i64_const(0) {
                crc = ((crc >> i64_const(1)) & (mask >> i64_const(1))) ^ poly;
            } else {
                crc = (crc >> i64_const(1)) & (mask >> i64_const(1));
            }
            bit = bit + i64_const(1);
        }
        i = i + i64_const(1);
    }
    return (crc ^ mask) % i64_const(1000000007);
}

fn main() -> i32 {
    print_int(crc32_checksum(i64_const(16384)));
    return 0;
}
