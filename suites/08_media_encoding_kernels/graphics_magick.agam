@lang.advance

fn i64_const(value: i64) -> i64 {
    return value;
}

fn graphics_magick_filter(dim: i64) -> i64 {
    let zero: i64 = i64_const(0);
    let one: i64 = i64_const(1);
    let four: i64 = i64_const(4);
    let thirty_one: i64 = i64_const(31);
    let mod_byte: i64 = i64_const(256);
    let mod_prime: i64 = i64_const(1000000007);

    let mut checksum: i64 = zero;
    let mut y: i64 = one;
    while y < dim - one {
        let mut x: i64 = one;
        while x < dim - one {
            let center: i64 = (x * y * thirty_one) % mod_byte;
            let top: i64 = (x * (y - one) * thirty_one) % mod_byte;
            let bottom: i64 = (x * (y + one) * thirty_one) % mod_byte;
            let left: i64 = ((x - one) * y * thirty_one) % mod_byte;
            let right: i64 = ((x + one) * y * thirty_one) % mod_byte;

            let mut laplacian: i64 = (center * four) - top - bottom - left - right;
            if laplacian < zero {
                laplacian = zero - laplacian;
            }
            checksum = (checksum + laplacian) % mod_prime;
            x = x + one;
        }
        y = y + one;
    }
    return checksum;
}

fn main() -> i32 {
    let res: i64 = graphics_magick_filter(i64_const(512));
    print_int(res);
    return 0;
}
