@lang.advance

fn i64_const(value: i64) -> i64 {
    return value;
}

fn flac_lpc_encode(samples: i64) -> i64 {
    let zero: i64 = i64_const(0);
    let one: i64 = i64_const(1);
    let lcg_mult: i64 = i64_const(1103515245);
    let lcg_add: i64 = i64_const(12345);
    let mod_amp: i64 = i64_const(32768);
    let mod_prime: i64 = i64_const(1000000007);

    let mut residual_sum: i64 = zero;
    let mut prev: i64 = zero;
    let mut i: i64 = zero;
    while i < samples {
        let sample: i64 = ((i * lcg_mult) + lcg_add) % mod_amp;
        let predicted: i64 = prev;
        let mut residual: i64 = sample - predicted;
        if residual < zero {
            residual = zero - residual;
        }
        residual_sum = (residual_sum + residual) % mod_prime;
        prev = sample;
        i = i + one;
    }
    return residual_sum;
}

fn main() -> i32 {
    let res: i64 = flac_lpc_encode(i64_const(100000));
    print_int(res);
    return 0;
}
