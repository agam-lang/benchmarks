@lang.advance

fn i64_const(value: i64) -> i64 { return value; }

fn fir_filter_block(buffer_len: i64, filter_len: i64, passes: i64) -> i64 {
    let mut energy_sum: i64 = i64_const(0);
    let mut p: i64 = i64_const(0);
    while p < passes {
        let mut i: i64 = filter_len;
        while i < buffer_len {
            let mut acc: i64 = i64_const(0);
            let mut k: i64 = i64_const(0);
            while k < filter_len {
                let input_val: i64 = ((i - k) % i64_const(17)) + i64_const(1);
                let coeff_val: i64 = (k % i64_const(7)) + i64_const(1);
                acc = acc + input_val * coeff_val;
                k = k + i64_const(1);
            }
            energy_sum = (energy_sum + acc * acc) % i64_const(1000000007);
            i = i + i64_const(1);
        }
        p = p + i64_const(1);
    }
    return energy_sum;
}

fn main() -> i32 {
    let energy = fir_filter_block(i64_const(256), i64_const(32), i64_const(2000));
    print_int(energy);
    return 0;
}
