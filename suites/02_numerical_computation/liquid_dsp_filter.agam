@lang.advance

fn liquid_dsp_fir(num_samples: i64, taps: i64) -> i64 {
    let mut accumulator: i64 = 0;
    let mut i: i64 = taps;
    while i < num_samples {
        let mut sample_acc: i64 = 0;
        let mut k: i64 = 0;
        while k < taps {
            let input_val: i64 = ((i - k) * 37) % 1000;
            let coeff: i64 = (k * 13) % 256;
            sample_acc = sample_acc + input_val * coeff;
            k = k + 1;
        }
        accumulator = (accumulator + sample_acc) % 1000000007;
        i = i + 1;
    }
    return accumulator;
}

fn main() -> i32 {
    let res: i64 = liquid_dsp_fir(50000, 32);
    print_int(res);
    return 0;
}
